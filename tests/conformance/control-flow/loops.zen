fn main() -> Int {
    var n = 0;
    var total = 0;
    while n < 6 {
        n = n + 1;
        if n == 2 {
            continue;
        }
        for item in [1, 2, 3] {
            if item == 2 {
                break;
            }
            total = total + n;
        }
        if n == 4 {
            break;
        }
    }
    return total;
}
