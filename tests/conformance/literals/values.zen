fn main() -> Bool {
    let nothing: Unit = unit;
    let zero = -0;
    return true
        && !false
        && zero
        == 0
        && 1.5
        + 2.5
        == 4.0
        && 'λ'
        == '\u{3bb}'
        && "مرحبا"
        + " 😀"
        == "مرحبا 😀"
        && -128i8
        < 127i8
        && -32768i16
        < 32767i16
        && -2147483648i32
        < 2147483647i32
        && -9223372036854775808i64
        < 9223372036854775807i64
        && 255u8
        > 0u8
        && 65535u16
        > 0u16
        && 4294967295u32
        > 0u32
        && 18446744073709551615u64
        > 0u64
        && 1.25f32
        * 2.0f32
        == 2.5f32;
}
