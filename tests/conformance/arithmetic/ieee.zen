fn main() -> Bool {
    let large = 1.0e308 * 1.0e308;
    let nan = large - large;
    let small = 1.0e30f32 * 1.0e30f32;
    let nan32 = small - small;
    return large
        > 1.0e308
        && -large
        < -1.0e308
        && nan
        != nan
        && !(nan < 0.0)
        && !(nan >= 0.0)
        && nan32
        != nan32;
}
