fn main() -> Bool {
    var n = 0;
    let a = false && {
        n = n + 1;
        true
    };
    let b = true || {
        n = n + 10;
        false
    };
    let c = true && {
        n = n + 100;
        true
    };
    let d = false || {
        n = n + 1000;
        true
    };
    return !a && b && c && d && n == 1100;
}
