fn read(x: Option<Int>) -> Option<String> {
    let n = x?;
    return .some("yes");
}

fn main() -> Bool {
    let lambda = (x: Option<Int>) -> Option<Int> {
        return .some(x? + 1);
    };
    return read(.some(1))
        == .some("yes")
        && read(.none)
        == .none
        && lambda(.none)
        == .none
        && lambda(.some(2))
        == .some(3);
}
